# ---- Required ----
GROQ_API_KEY=

# ---- Qdrant Cloud (leave both empty to use an in-memory Qdrant inside the app) ----
QDRANT_URL=
QDRANT_API_KEY=

# ---- Optional ----
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_MODEL_SMART=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
AUTO_APPROVE_MAX_RISK=medium
RATE_LIMIT_PER_HOUR=30
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
# Optional regex for extra origins, e.g. Vercel preview URLs:
# CORS_ORIGIN_REGEX=https://triage-graph(-[a-z0-9-]+)?\.vercel\.app

# ---- Optional: LangSmith tracing ----
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=triagegraph

# ---- Optional: Azure OpenAI instead of Groq ----
# LLM_PROVIDER=azure_openai
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_DEPLOYMENT_SMART=gpt-4o
# AZURE_DEPLOYMENT_FAST=gpt-4o-mini
